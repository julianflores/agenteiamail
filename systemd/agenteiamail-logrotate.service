# Template. Replace /path/to/agenteiamail with your clone's absolute path.
[Unit]
Description=Rotate agenteiamail logs

[Service]
Type=oneshot
# copytruncate, not rename: systemd holds the log open in append mode, and a
# rename sends every subsequent line to a file nobody reads. Silently.
ExecStart=/usr/bin/python3 /path/to/agenteiamail/harness/rotate_logs.py
