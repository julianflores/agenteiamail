# Template. Replace /path/to/agenteiamail with your clone's absolute path.
#
# This calls harness/watch_service.sh, NOT watch.sh directly: the wrapper works
# out which byte of the log to resume from before handing over.

[Unit]
Description=agenteiamail watcher (pushes new-mail events into the session)
After=agenteiamail-idle.service

[Service]
Type=simple
ExecStart=/usr/bin/bash /path/to/agenteiamail/harness/watch_service.sh
WorkingDirectory=/path/to/agenteiamail
Restart=always
RestartSec=10
SyslogIdentifier=agenteiamail-watch

[Install]
WantedBy=default.target
